# ========== 服务配置(给startJar.sh用的) ==========
# JAR包路径（相对于脚本所在目录或绝对路径）
JAR_FILE=/home/mikuyun/java_app/mikuyun-admin/target/mikuyun-admin-1.0.0.jar

# 服务监听端口
PORT=8091

# 服务名称（用于日志标识）
SERVICE_NAME="mikuyun-admin"

# JVM启动参数（可选，留空则使用默认）
JAVA_OPTS="-Xms256m -Xmx512m"

# 应用运行参数（可选，如 --spring.profiles.active=prod）
APP_ARGS="--spring.profiles.active=prod"

# 日志输出文件（可选，留空则输出到 nohup.out）
LOG_FILE="../logs/mikuyun-admin.log"
